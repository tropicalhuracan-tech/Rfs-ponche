{
  "buildCommand": "sh -c 'test -f dist/panel/index.html && grep -rq \"Eliminar vigilante\" dist/assets/panel-*.js' || npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/panel",
      "destination": "/panel/index.html"
    },
    {
      "source": "/panel/",
      "destination": "/panel/index.html"
    },
    {
      "source": "/((?!api/|panel/|assets/|sw.js|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "installCommand": "npm ci"
}
