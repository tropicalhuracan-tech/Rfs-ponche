{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/panel", "destination": "/panel/index.html" },
    { "source": "/panel/", "destination": "/panel/index.html" },
    { "source": "/((?!api/|panel/|assets/|sw.js|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
